# Copy to deploy/.env and fill in. Keys and passwords live only in this file on the server:
# never in the repository.

# The domain the instance answers on (Caddy gets its certificate). "localhost" for a try-out.
NABU_DOMAIN=localhost
# Postgres's password: any long random string (`openssl rand -base64 32`).
POSTGRES_PASSWORD=

# Weekly leagues and practice reminders (off unless 1).
NABU_LEAGUES=
NABU_PUSH=
NABU_VAPID_SUBJECT=mailto:you@example.com

# The reviewers' bearer token for /admin/v1 (unset: no review endpoints).
NABU_ADMIN_TOKEN=

# A model for the AI features (unset: they are off). With the llm profile:
#   NABU_LLM=ollama  NABU_LLM_URL=http://ollama:11434  NABU_LLM_MODEL=<a model you pulled>
NABU_LLM=
NABU_LLM_MODEL=
NABU_LLM_URL=
NABU_LLM_KEY=

# The speech service, with the speech profile: http://speech:8790
NABU_SPEECH_URL=

# Abuse limits are on; "off" turns them off. One limit: NABU_RATE_LIMIT_SIGN_UP=5/3600 (max/seconds).
NABU_RATE_LIMITS=

# An age gate (ADR 0069), for an instance that may serve minors: sign-up asks the person's age and
# needs at least this many years, e.g. 13 or 16, as the law where you serve requires. The server
# keeps nothing of the answer; anyone turned away can still learn on their device. Empty: no gate.
NABU_MIN_AGE=

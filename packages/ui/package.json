{
  "name": "@nabu/ui",
  "version": "0.0.0",
  "private": true,
  "description": "React Aria–based components, writing-mode aware. Home of <T>, the only way language data reaches the DOM.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fonts.css": "./src/fonts.css",
    "./tokens.css": "./src/tokens.css",
    "./demo": "./src/demo/index.ts",
    "./player": "./src/player/index.ts",
    "./story": "./src/story/index.ts",
    "./ai": "./src/ai/index.ts"
  },
  "scripts": {
    "codegen": "node scripts/css-module-types.ts",
    "typecheck": "node scripts/css-module-types.ts --check && tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" \".storybook/**/*.css\"",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --quiet -o storybook-static",
    "test:visual": "playwright test",
    "test:visual:update": "pnpm build-storybook && node tests/visual/docker.mjs --update-snapshots",
    "test:visual:docker": "pnpm build-storybook && node tests/visual/docker.mjs"
  },
  "dependencies": {
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-hk": "^5.3.1",
    "@fontsource/vazirmatn": "^5.3.0",
    "@nabu/core": "workspace:*",
    "@nabu/i18n": "workspace:*",
    "@nabu/schema": "workspace:*",
    "react-aria-components": "^1.22.1",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}

{
  "name": "@nabu/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript core: text model, normalization, matching, templates, scheduling, planner, game rules. No I/O, no clock, no ambient randomness.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./text": "./src/text/index.ts",
    "./lesson": "./src/lesson/index.ts",
    "./learner": "./src/learner/index.ts",
    "./story": "./src/story/index.ts",
    "./game": "./src/game/index.ts",
    "./ai": "./src/ai/index.ts",
    "./speech": "./src/speech/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "simulate": "node scripts/simulate.ts",
    "tone-eval": "node scripts/tone-eval.ts"
  },
  "dependencies": {
    "@nabu/schema": "workspace:*",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}

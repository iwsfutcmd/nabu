{
  "name": "@nabu/schema",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript types generated from /schemas. Never hand-edit src/generated.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./json/*": "../../schemas/*"
  },
  "scripts": {
    "codegen": "node scripts/codegen.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1",
    "@types/node": "^22.20.5"
  }
}

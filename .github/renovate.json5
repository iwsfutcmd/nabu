// Dependency updates (Phase 11). This file does nothing until the Renovate GitHub App is installed
// on the repository: installing it is the owner's decision. Every update is an ordinary PR, and
// CI (the license check included) decides whether it can land.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":semanticCommitTypeAll(chore)"],
  // Weekly and a few at a time: every PR runs the whole CI (visual matrix, e2e, Android).
  schedule: ["before 5am on monday"],
  prConcurrentLimit: 5,
  // A release has to have been out for a few days before it is proposed (a hijacked release is
  // usually pulled within hours).
  minimumReleaseAge: "3 days",
  internalChecksFilter: "strict",
  // Majors wait for approval on the dependency dashboard: each one is a decision, often an ADR.
  major: { dependencyDashboardApproval: true },
  lockFileMaintenance: { enabled: true, schedule: ["before 5am on the first day of the month"] },
  ignorePaths: [
    // The defaults of config:recommended (this setting replaces them).
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    // Generated by Capacitor (ADR 0048): updated by `cap sync` with @capacitor/*, never by hand.
    "apps/mobile/android/**",
    "apps/mobile/ios/**",
    // Navoiy's runtime pins an older torch and transformers on purpose (ADR 0059).
    "pipeline/runtimes/cosyvoice/**",
  ],
  packageRules: [
    {
      description: "TypeScript stays on 6.x: typescript-eslint's type-aware rules need the JS compiler API, which TypeScript 7 lacks (CLAUDE.md, ADR 0013-0026).",
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      description: "Playwright moves as one: the npm packages and the container the visual baselines are taken in. Baselines are redone in that container and every changed PNG reviewed, so these wait for approval.",
      groupName: "Playwright",
      matchPackageNames: ["@playwright/test", "mcr.microsoft.com/playwright"],
      dependencyDashboardApproval: true,
      prBodyNotes: ["Run `pnpm test:visual:update` (the pinned container) on this branch and review every changed PNG before merging."],
    },
    {
      description: "CLDR data is generated into packages/i18n/src/generated; CI fails until it is regenerated.",
      groupName: "CLDR",
      matchPackageNames: ["cldr-*"],
      prBodyNotes: ["Run `pnpm cldr` on this branch and commit packages/i18n/src/generated (CI fails until then)."],
    },
    {
      description: "The database drivers move together; the api-postgres job tests them on real Postgres.",
      groupName: "database",
      matchPackageNames: ["@electric-sql/pglite", "drizzle-orm", "pg", "@types/pg"],
    },
    {
      description: "Capacitor moves as one, and its android/ and ios/ projects are regenerated with it.",
      groupName: "Capacitor",
      matchPackageNames: ["@capacitor/**"],
      prBodyNotes: ["After merging, run `pnpm --filter @nabu/mobile build` (cap sync) and commit the regenerated android/ and ios/ projects."],
    },
    {
      description: "A new major of Postgres needs a dump and a restore on every instance (deploy/README.md), so it is never proposed automatically.",
      matchDatasources: ["docker"],
      matchPackageNames: ["postgres"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "The course pipeline's analyzers and voices can change compiled bundles and golden files.",
      matchFileNames: ["pipeline/pyproject.toml"],
      prBodyNotes: ["If CI reports stale bundles or golden files, rebuild them (`pnpm bundles`, UPDATE_GOLDEN=1) and review the diff: a changed analysis is a content change."],
    },
  ],
}

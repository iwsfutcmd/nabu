{
  "name": "nabu",
  "private": true,
  "description": "Open-source, script-first, Duolingo-style language-learning app",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "codegen": "turbo run codegen",
    "codegen:check": "turbo run codegen && git diff --exit-code",
    "lint": "turbo run lint lint:css",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:visual": "turbo run test:visual",
    "test:visual:docker": "pnpm --filter @nabu/ui test:visual:docker",
    "test:visual:update": "pnpm --filter @nabu/ui test:visual:update",
    "storybook": "pnpm --filter @nabu/ui storybook",
    "cldr": "pnpm --filter @nabu/i18n generate:cldr",
    "test:perf": "turbo run test:perf",
    "test:e2e": "pnpm --filter @nabu/web test:e2e",
    "conformance": "pnpm --filter @nabu/core-cli exec vitest run test/conformance.test.ts && cd pipeline && uv run --frozen pytest -q tests/test_conformance.py",
    "tables": "cd pipeline && uv run --frozen nabu tables",
    "courses": "cd pipeline && uv run --frozen nabu build ../courses --check",
    "bundles": "cd pipeline && uv run --frozen nabu build ../courses --out ../apps/web/public/bundles",
    "license-check": "node packages/lint/scripts/licenses.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nabu/lint": "workspace:*",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "stylelint": "^17.16.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}

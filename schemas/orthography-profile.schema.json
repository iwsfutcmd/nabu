{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nabu.invalid/schemas/v0/orthography-profile.schema.json",
  "title": "OrthographyProfile",
  "description": "Declarative description of how a writing system behaves: normalization, matching, segmentation, annotation layers, input aids and layout (gameplan §6.3). Adding a script means adding one of these plus fixtures, not editing the grader.",
  "$comment": "v0 (Phase 0). Shapes follow the three examples in gameplan §6.3. Step and policy vocabularies are closed enums on purpose: a new value needs an engine implementation (Phase 1) and conformance vectors before a profile may use it.",
  "type": "object",
  "required": [
    "id",
    "lang",
    "segmentation",
    "normalize"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/OrthographyId"
    },
    "lang": {
      "$ref": "common.schema.json#/$defs/ScriptedLangTag"
    },
    "exemplars": {
      "description": "CLDR locale whose main/auxiliary/punctuation/numbers exemplars drive the script audit (§7.5). Both CLDR (yue_Hant) and BCP 47 (yue-Hant) separators are accepted in v0.",
      "type": "string",
      "pattern": "^cldr:[a-z]{2,3}([_-][A-Z][a-z]{3})?([_-](?:[A-Z]{2}|[0-9]{3}))?$"
    },
    "exemplarsExtra": {
      "description": "Characters the orthography uses that its CLDR exemplars lack, such as the Cantonese colloquial characters 佢 哋 嘅 咗 missing from cldr:yue_Hant (CLDR 49). The script audit treats them as main exemplars, and punctuation among them (the Hebrew sof pasuq ׃, missing from cldr:he) as exemplar punctuation. Each entry is a gap to report upstream to CLDR, not a licence to widen the audit.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "letters": {
      "description": "The alphabet as the orthography defines it, including multigraph letters (sh, ch, ng, oʻ). Typo distance and letter-level exercises use it, longest match first.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "segmentation": {
      "$ref": "#/$defs/Segmentation"
    },
    "normalize": {
      "description": "Applied identically to learner answers and accept sets, in order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/NormalizeStep"
      }
    },
    "match": {
      "$ref": "#/$defs/MatchPolicy"
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnnotationLayer"
      }
    },
    "input": {
      "$ref": "#/$defs/InputAids"
    },
    "layout": {
      "$ref": "#/$defs/Layout"
    },
    "strokeOrder": {
      "$ref": "#/$defs/StrokeOrder"
    },
    "fonts": {
      "$ref": "#/$defs/Fonts"
    },
    "romanize": {
      "description": "How the compiler spells the orthography's letters and words in Latin letters for a learner still learning the script (ADR 0088): a scheme implemented in the pipeline.",
      "type": "string",
      "enum": ["greek"]
    },
    "transliterate": {
      "$ref": "#/$defs/Transliteration"
    }
  },
  "$defs": {
    "Policy": {
      "title": "Policy",
      "description": "What the grader does when an answer differs from the accept set only in this respect.",
      "type": "string",
      "enum": [
        "ignore",
        "accept",
        "accept-with-note",
        "partial-credit",
        "reject-with-note",
        "reject"
      ]
    },
    "UnicodeSetPattern": {
      "title": "UnicodeSetPattern",
      "description": "A UnicodeSet in UTS #35 syntax, e.g. [\\u064B-\\u0652\\u0670].",
      "type": "string",
      "pattern": "^\\[.*\\]$"
    },
    "Segmentation": {
      "title": "Segmentation",
      "type": "object",
      "required": [
        "content",
        "runtime"
      ],
      "additionalProperties": false,
      "properties": {
        "content": {
          "description": "Compile-time analyzer that segments content (§7.5), or hand-pinned.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "examples": [
            "hazm",
            "pycantonese",
            "hand-pinned",
            "whitespace"
          ]
        },
        "runtime": {
          "description": "Runtime comparison unit. Never word segmentation (§6.5).",
          "type": "string",
          "enum": [
            "grapheme"
          ]
        }
      }
    },
    "NormalizeStep": {
      "title": "NormalizeStep",
      "oneOf": [
        {
          "$ref": "#/$defs/NfcStep"
        },
        {
          "$ref": "#/$defs/FoldCompatStep"
        },
        {
          "$ref": "#/$defs/FoldWidthStep"
        },
        {
          "$ref": "#/$defs/MapStep"
        },
        {
          "$ref": "#/$defs/RemoveStep"
        },
        {
          "$ref": "#/$defs/DigitsStep"
        },
        {
          "$ref": "#/$defs/PunctuationStep"
        },
        {
          "$ref": "#/$defs/WhitespaceStep"
        },
        {
          "$ref": "#/$defs/DetachStep"
        },
        {
          "$ref": "#/$defs/LogographsStep"
        }
      ]
    },
    "NfcStep": {
      "title": "NfcStep",
      "description": "Canonical composition. NFKC is never a step: compatibility folding only happens through named fold steps (§6.4).",
      "type": "string",
      "const": "nfc"
    },
    "FoldCompatStep": {
      "title": "FoldCompatStep",
      "type": "object",
      "required": [
        "fold-compat"
      ],
      "additionalProperties": false,
      "properties": {
        "fold-compat": {
          "type": "string",
          "enum": [
            "arabic-presentation-forms"
          ]
        }
      }
    },
    "FoldWidthStep": {
      "title": "FoldWidthStep",
      "type": "object",
      "required": [
        "fold-width"
      ],
      "additionalProperties": false,
      "properties": {
        "fold-width": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "ascii": {
              "$ref": "#/$defs/Width"
            },
            "punctuation": {
              "$ref": "#/$defs/Width"
            },
            "katakana": {
              "$ref": "#/$defs/Width"
            }
          }
        }
      }
    },
    "Width": {
      "title": "Width",
      "type": "string",
      "enum": [
        "half",
        "full"
      ]
    },
    "MapStep": {
      "title": "MapStep",
      "description": "Literal string replacements, longest key first.",
      "type": "object",
      "required": [
        "map"
      ],
      "additionalProperties": false,
      "properties": {
        "map": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "RemoveStep": {
      "title": "RemoveStep",
      "type": "object",
      "required": [
        "remove"
      ],
      "additionalProperties": false,
      "properties": {
        "remove": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "NumberingSystem": {
      "title": "NumberingSystem",
      "description": "A CLDR numbering-system id (latn, arab, arabext, hanidec…).",
      "type": "string",
      "pattern": "^[a-z]{3,8}$"
    },
    "DigitsStep": {
      "title": "DigitsStep",
      "type": "object",
      "required": [
        "digits"
      ],
      "additionalProperties": false,
      "properties": {
        "digits": {
          "type": "object",
          "required": [
            "canonical",
            "accept"
          ],
          "additionalProperties": false,
          "properties": {
            "canonical": {
              "$ref": "#/$defs/NumberingSystem"
            },
            "accept": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/NumberingSystem"
              }
            }
          }
        }
      }
    },
    "PunctuationStep": {
      "title": "PunctuationStep",
      "description": "strip removes General_Category P* only. Modifier letters such as U+02BB and U+02BC (gc=Lm) are letters and are never stripped.",
      "type": "object",
      "required": [
        "punctuation"
      ],
      "additionalProperties": false,
      "properties": {
        "punctuation": {
          "type": "string",
          "enum": [
            "strip",
            "keep"
          ]
        }
      }
    },
    "WhitespaceStep": {
      "title": "WhitespaceStep",
      "type": "object",
      "required": [
        "whitespace"
      ],
      "additionalProperties": false,
      "properties": {
        "whitespace": {
          "type": "string",
          "enum": [
            "collapse",
            "remove",
            "keep"
          ]
        }
      }
    },
    "DetachStep": {
      "title": "DetachStep",
      "description": "Splits a prefix written onto the next word off from it, so the attached and the separate spellings compare alike (Arabizi elshay = el shay). A word that starts with one of the prefixes, ignoring case and by whole graphemes, and has at least minRest more graphemes, gets a space after the prefix.",
      "type": "object",
      "required": [
        "detach"
      ],
      "additionalProperties": false,
      "properties": {
        "detach": {
          "type": "object",
          "required": [
            "prefixes"
          ],
          "additionalProperties": false,
          "properties": {
            "prefixes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "minRest": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            }
          }
        }
      }
    },
    "LogographsStep": {
      "title": "LogographsStep",
      "description": "Words typed in a script that spells them, written as this orthography's logographs (ADR 0086): a learner can type sitelen pona as sitelen Lasina, toki for U+F196C. Each whole word (a run of letters and marks) that is a key, ignoring case, becomes its value. With `cartouche`, a name written inside one reads as the letters its logographs begin with (open, sona, olin, nasin, jan, a, close is sonja), the marks dropped, so a name typed in Latin letters compares alike. Names are read before words, so a name that spells a word (kili) becomes that word's logograph on both sides.",
      "type": "object",
      "required": [
        "logographs"
      ],
      "additionalProperties": false,
      "properties": {
        "logographs": {
          "type": "object",
          "required": [
            "words"
          ],
          "additionalProperties": false,
          "properties": {
            "words": {
              "description": "Each word, as it is typed, and the logograph that writes it.",
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "cartouche": {
              "description": "The marks that open and close a name written with the logographs' first letters.",
              "type": "object",
              "required": [
                "open",
                "close"
              ],
              "additionalProperties": false,
              "properties": {
                "open": {
                  "type": "string",
                  "minLength": 1
                },
                "close": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "MatchPolicy": {
      "title": "MatchPolicy",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marks": {
          "type": "object",
          "required": [
            "set",
            "policy"
          ],
          "additionalProperties": false,
          "properties": {
            "set": {
              "$ref": "#/$defs/UnicodeSetPattern"
            },
            "policy": {
              "$ref": "#/$defs/Policy"
            },
            "note": {
              "$ref": "#/$defs/NoteId"
            },
            "optional": {
              "$ref": "#/$defs/UnicodeSetPattern",
              "description": "Marks of the set a learner supplying a word's vowel marks (the vocalize exercise, ADR 0054) may write or leave out: sukun, where the course's conventions differ."
            },
            "distinguishes": {
              "description": "Marks that tell words apart (ADR 0076): the Spanish tilde in está/esta, sí/si, habló/hablo. An answer whose marks differ from the expected word's and so spell another word of the course (the grader's lexicon) is WRONG_WORD, with `wordNote`; otherwise the policy applies.",
              "type": "boolean"
            },
            "wordNote": {
              "$ref": "#/$defs/NoteId",
              "description": "The note for an answer whose marks spell another word (with `distinguishes`)."
            }
          }
        },
        "zwnj": {
          "type": "object",
          "required": [
            "equivalents",
            "policy"
          ],
          "additionalProperties": false,
          "properties": {
            "equivalents": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "policy": {
              "$ref": "#/$defs/Policy"
            },
            "note": {
              "$ref": "#/$defs/NoteId"
            }
          }
        },
        "case": {
          "oneOf": [
            {
              "type": "string",
              "const": "none"
            },
            {
              "type": "object",
              "required": [
                "locale"
              ],
              "additionalProperties": false,
              "properties": {
                "locale": {
                  "$ref": "common.schema.json#/$defs/LangTag"
                }
              }
            }
          ]
        },
        "typo": {
          "type": "object",
          "required": [
            "model"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "enum": [
                "keyboard",
                "marks",
                "ime-homophone"
              ]
            },
            "layout": {
              "$ref": "#/$defs/KeyboardRef"
            },
            "unit": {
              "type": "string",
              "enum": [
                "graphemes",
                "letters"
              ]
            },
            "maxRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "minLength": {
              "description": "Tokens shorter than this many units get no typo tolerance (default 3).",
              "type": "integer",
              "minimum": 1
            },
            "contrasts": {
              "description": "Endings, or whole words, that carry meaning, in sets: person endings, possessive endings, case endings, pronouns. A slip that turns one member of a set into another at the end of a word, the rest unchanged, is WRONG_WORD, not a typo: talabasan for talabaman, kitobing for kitobim (erratum 46). Members match after case folding, the profile's equivalences and its marks, as units are compared, so a hamza-less spelling still counts. A member may list several spellings of one meaning (the dative ga, ka, qa): trading those stays a typo.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Contrast"
              }
            }
          }
        },
        "variants": {
          "type": "object",
          "required": [
            "table",
            "policy"
          ],
          "additionalProperties": false,
          "properties": {
            "table": {
              "$ref": "#/$defs/TableRef"
            },
            "policy": {
              "$ref": "#/$defs/Policy"
            },
            "note": {
              "$ref": "#/$defs/NoteId"
            }
          }
        },
        "scriptMismatch": {
          "type": "object",
          "required": [
            "detect",
            "table",
            "policy"
          ],
          "additionalProperties": false,
          "properties": {
            "detect": {
              "$ref": "common.schema.json#/$defs/ScriptCode"
            },
            "policy": {
              "$ref": "#/$defs/Policy"
            },
            "table": {
              "$ref": "#/$defs/TableRef"
            },
            "note": {
              "$ref": "#/$defs/NoteId"
            }
          }
        },
        "homophones": {
          "type": "object",
          "required": [
            "model",
            "table",
            "policy"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "policy": {
              "$ref": "#/$defs/Policy"
            },
            "table": {
              "$ref": "#/$defs/TableRef"
            }
          }
        },
        "apostrophe": {
          "type": "object",
          "required": [
            "policy"
          ],
          "additionalProperties": false,
          "properties": {
            "policy": {
              "$ref": "#/$defs/Policy"
            },
            "note": {
              "$ref": "#/$defs/NoteId"
            }
          }
        },
        "equivalences": {
          "description": "Folds applied to both the answer and the accept set only for comparison, each with its own policy, e.g. Arabic hamza seats (accept-with-note) or Arabizi ch/sh (accept). The first equivalence that makes two units equal decides the policy; normalization steps, by contrast, fold silently.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Equivalence"
          }
        }
      }
    },
    "NoteId": {
      "title": "NoteId",
      "description": "Key of a feedback note in the MF2 catalogs (feedback.note.<id>).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "KeyboardRef": {
      "title": "KeyboardRef",
      "description": "A CLDR Keyboard 3.0 layout (UTS #35 Part 7).",
      "type": "string",
      "pattern": "^cldr-kbd:[A-Za-z0-9_-]+$"
    },
    "AnnotationLayer": {
      "title": "AnnotationLayer",
      "type": "object",
      "required": [
        "id",
        "kind",
        "toggle"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "reading",
            "vocalization",
            "gloss"
          ]
        },
        "toggle": {
          "type": "boolean"
        },
        "default": {
          "type": "string",
          "enum": [
            "on",
            "off",
            "on-for-new-words"
          ]
        },
        "scheme": {
          "$ref": "common.schema.json#/$defs/SchemeId"
        },
        "lang": {
          "description": "The language tag of the layer's own text (ADR 0071), so it is announced and shaped as what it is: Jyutping is yue-Latn-jyutping, Pinyin zh-Latn-pinyin, Baxter's Middle Chinese ltc-Latn-x-baxter. Without it the annotation takes the base text's tag.",
          "$ref": "common.schema.json#/$defs/ScriptedLangTag"
        },
        "render": {
          "type": "string",
          "enum": [
            "ruby",
            "inline",
            "interlinear"
          ]
        },
        "fade": {
          "type": "string",
          "enum": [
            "none",
            "by-facet"
          ]
        }
      }
    },
    "InputAids": {
      "title": "InputAids",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keyboard": {
          "$ref": "#/$defs/KeyboardRef"
        },
        "extraKeys": {
          "description": "Characters for the special-character bar, in addition to the auxiliary exemplars (§6.7).",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ime": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(:[a-z0-9-]+)?$"
          }
        }
      }
    },
    "Layout": {
      "title": "Layout",
      "type": "object",
      "required": [
        "vertical"
      ],
      "additionalProperties": false,
      "properties": {
        "vertical": {
          "description": "Which vertical writing mode the orthography supports, if any (§11.4).",
          "type": "string",
          "enum": [
            "none",
            "vertical-rl",
            "vertical-lr"
          ]
        },
        "verticalPolicy": {
          "description": "toggle: vertical is a user option (CJK). always: the orthography is only ever set vertically (traditional Mongolian). Defaults to toggle.",
          "type": "string",
          "enum": [
            "toggle",
            "always"
          ],
          "default": "toggle"
        },
        "verticalScope": {
          "description": "Surfaces that may switch to vertical. App chrome never does.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "prompt",
              "reading",
              "wordbank"
            ]
          }
        }
      }
    },
    "StrokeOrderStandard": {
      "title": "StrokeOrderStandard",
      "type": "string",
      "enum": [
        "prc",
        "tw",
        "hk",
        "ja"
      ]
    },
    "StrokeOrder": {
      "title": "StrokeOrder",
      "type": "object",
      "required": [
        "target",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/StrokeOrderStandard"
        },
        "interim": {
          "$ref": "#/$defs/StrokeOrderStandard"
        },
        "label": {
          "type": "boolean"
        }
      }
    },
    "Fonts": {
      "title": "Fonts",
      "type": "object",
      "required": [
        "stack"
      ],
      "additionalProperties": false,
      "properties": {
        "stack": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scale": {
          "description": "How much larger than the text around it the orthography's text is set (1: the same). Han characters at the size of the Latin around them are hard to read: Classical Chinese is 1.25 (ADR 0071). The learner's text size preference scales both.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        }
      }
    },
    "Transliteration": {
      "title": "Transliteration",
      "type": "object",
      "required": [
        "to",
        "via"
      ],
      "additionalProperties": false,
      "properties": {
        "to": {
          "$ref": "common.schema.json#/$defs/OrthographyId"
        },
        "via": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(:[A-Za-z0-9_/-]+)?$"
        }
      }
    },
    "Equivalence": {
      "title": "Equivalence",
      "type": "object",
      "required": [
        "id",
        "map",
        "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "map": {
          "description": "Literal replacements, longest key first, applied to both sides.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "note": {
          "$ref": "#/$defs/NoteId"
        }
      }
    },
    "TableRef": {
      "title": "TableRef",
      "description": "Id of a data table in profiles/tables/<id>.json (schemas/data-table.schema.json).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "Contrast": {
      "title": "Contrast",
      "description": "A set of endings, prefixes (or whole words) one letter or two apart that mean different things.",
      "type": "object",
      "required": [
        "id",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "members": {
          "description": "The members, each a meaning. An empty spelling is the word with no such affix: the bare Lebanese imperfect (shteghel) beside b-shteghel, a masculine adjective beside its feminine.",
          "type": "array",
          "minItems": 2,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "Spellings of one member (allomorphs)."
              }
            ]
          }
        },
        "at": {
          "description": "Where the members stand: at the end of the word (endings, stacking like suffixes) or at its start (prefixes: Lebanese b-, bt-, mn- on verbs). Default end.",
          "enum": [
            "end",
            "start"
          ]
        },
        "after": {
          "description": "For prefixes: what may come before the member, a proclitic written onto the word (Arabic و 'and': وبشتغل).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inflected": {
          "description": "Only on words the course inflects: a word the grader is told carries a form (GradeOptions.inflected: tokens whose sense has a form KC somewhere in the course). A noun's first letter is a typo; a verb's prefix is not.",
          "type": "boolean"
        },
        "forms": {
          "description": "Only on words the course pins as one of these forms (GradeOptions.forms: the forms of the tokens a word spells): form KC ids, or how they begin (form:yiqtol matches form:yiqtol-3ms). Narrower than inflected, for a course that pins forms on nouns too: Biblical Hebrew's person prefixes are a verb's, never a noun's first letter, and its perfect endings a perfect's, never an infinitive's (ADR 0084).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^form:[a-z0-9-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "note": {
          "description": "The feedback note shown with the verdict (MF2 message feedback.note.<note>).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    }
  }
}

    "AnswerSubmittedV1": {
      "title": "AnswerSubmittedV1",
      "description": "One graded answer (§9.6). Raw answers are personal data (§14.4).",
      "type": "object",
      "required": [
        "id",
        "type",
        "schema",
        "device",
        "course",
        "orthography",
        "support",
        "bundle",
        "session",
        "clientTime",
        "localDate",
        "tz",
        "exercise",
        "attempt",
        "input",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "answer_submitted"
        },
        "id": {
          "description": "UUIDv7, generated on the device. Uploads are idempotent on it.",

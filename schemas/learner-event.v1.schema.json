                "WRONG_WORD",
                "WRONG",
                "SKIPPED"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kcs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/KcCreditV1"
              }
            }
          }

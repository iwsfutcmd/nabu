{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nabu.invalid/schemas/v0/audio-index.schema.json",
  "title": "AudioIndex",
  "description": "A course's audio clips (courses/<id>/audio/index.yaml), written by `nabu audio` and checked in. Every clip carries its SPDX license and provenance; synthesized clips record their exact input so a changed reading re-synthesizes only the clips it affects (§10.1).",
  "type": "object",
  "required": [
    "version",
    "clips"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "clips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AudioClip"
      }
    },
    "references": {
      "description": "Reference voices (`nabu audio cast`): a short recording a voice-cloning provider (OmniVoice) clones for every clip, so one course voice sounds like one speaker.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReferenceVoice"
      }
    }
  },
  "$defs": {
    "ReferenceVoice": {
      "title": "ReferenceVoice",
      "type": "object",
      "required": [
        "id",
        "file",
        "sha256",
        "text",
        "durationMs",
        "license",
        "provenance",
        "synthetic"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The id a course voice names as its `voice`.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "file": {
          "description": "The recording, relative to the audio directory (voices/<id>.wav: 16-bit PCM, kept lossless for cloning).",
          "type": "string",
          "pattern": "^voices/[a-z][a-z0-9-]*\\.wav$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "text": {
          "description": "What the recording says, NFC: the cloning prompt's transcript.",
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "license": {
          "$ref": "course-source.schema.json#/$defs/Spdx"
        },
        "provenance": {
          "$ref": "course-source.schema.json#/$defs/Provenance"
        },
        "synthetic": {
          "description": "Made by a model (`design`), not recorded: designed from speaker attributes (OmniVoice) or cloned from a prompt recording (Navoiy).",
          "type": "boolean"
        },
        "source": {
          "description": "A recorded reference (not synthetic): where the recording came from, a URL or a description, for its license's attribution (ADR 0075). The speaker is the provenance's human:<id>.",
          "type": "string",
          "minLength": 1
        },
        "design": {
          "description": "How a synthetic reference was made, so it can be made again.",
          "type": "object",
          "required": [
            "provider",
            "version",
            "language",
            "instruct",
            "seed"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "instruct": {
              "description": "The speaker attributes (\"male, young adult, moderate pitch\"), or for Navoiy the style instruction.",
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "dtype": {
              "description": "The weights' precision (\"bfloat16\").",
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "description": "A recording the voice was cloned from, for a model that clones rather than designs (Navoiy, ADR 0059): where it is, its sha256 and its license. It is not kept in the course.",
              "type": "object",
              "required": [
                "source",
                "sha256",
                "license"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "description": "The file at a pinned commit (\"https://github.com/FunAudioLLM/CosyVoice/blob/<commit>/asset/zero_shot_prompt.wav\").",
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "license": {
                  "$ref": "course-source.schema.json#/$defs/Spdx"
                }
              }
            }
          }
        }
      }
    },
    "AudioClip": {
      "title": "AudioClip",
      "type": "object",
      "required": [
        "item",
        "speed",
        "file",
        "sha256",
        "durationMs",
        "license",
        "provenance",
        "synthetic"
      ],
      "additionalProperties": false,
      "properties": {
        "item": {
          "description": "Sentence id, or KC id for a word.",
          "type": "string",
          "minLength": 1
        },
        "speed": {
          "type": "string",
          "enum": [
            "normal",
            "slow"
          ]
        },
        "file": {
          "description": "Relative to the audio directory.",
          "type": "string",
          "pattern": "^clips/[0-9a-f]{16}\\.mp3$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "license": {
          "$ref": "course-source.schema.json#/$defs/Spdx"
        },
        "provenance": {
          "$ref": "course-source.schema.json#/$defs/Provenance"
        },
        "source": {
          "description": "Where a recording came from (URL or description), for attribution.",
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "description": "Synthesized speech: labelled as such to learners.",
          "type": "boolean"
        },
        "synthesis": {
          "$ref": "#/$defs/SynthesisRecord"
        },
        "timings": {
          "description": "Start and end of each token of the sentence, for karaoke and tap-a-word (§10.3).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenTiming"
          }
        },
        "timingSource": {
          "type": "string",
          "enum": [
            "synthesis",
            "alignment"
          ]
        },
        "qa": {
          "$ref": "#/$defs/AudioQa"
        },
        "rejected": {
          "$ref": "#/$defs/AudioRejection"
        }
      }
    },
    "SynthesisRecord": {
      "title": "SynthesisRecord",
      "type": "object",
      "required": [
        "provider",
        "version",
        "voice",
        "input",
        "rate",
        "inputHash"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "description": "The exact string the provider read (a pinned reading, or text).",
          "type": "string"
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "settings": {
          "description": "Provider settings that shape the audio besides the voice and rate (a hosted provider's language and voice settings); part of the identity when present.",
          "type": "object"
        },
        "take": {
          "description": "Which attempt this is (ADR 0060): a clip a listener rejected is made again with the next take, which samples with another seed. Part of the identity when present.",
          "type": "integer",
          "minimum": 1
        },
        "inputHash": {
          "description": "sha256 of provider, version, voice, input, rate and settings: the clip's identity.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "TokenTiming": {
      "title": "TokenTiming",
      "type": "object",
      "required": [
        "token",
        "startMs",
        "endMs"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "integer",
          "minimum": 0
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "AudioQa": {
      "title": "AudioQa",
      "description": "Automatic checks (§10.1): what the synthesizer reports it said, and what a recognizer hears.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace": {
          "description": "The phonemes the synthesizer reports for the pinned reading.",
          "type": "string"
        },
        "asrModel": {
          "type": "string"
        },
        "asrText": {
          "type": "string"
        },
        "cer": {
          "description": "Character error rate of the recognized text against the expected text.",
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "review",
            "fail"
          ]
        }
      }
    },
    "AudioRejection": {
      "title": "AudioRejection",
      "description": "A listener heard the clip and judged it wrong (`nabu audio verdicts`): its item stays out of bundles until it is made again.",
      "type": "object",
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "description": "Who judged it: human:<id>.",
          "type": "string",
          "pattern": "^human:[^\\s@]+$"
        },
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}

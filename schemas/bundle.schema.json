{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nabu.invalid/schemas/v0/bundle.schema.json",
  "title": "BundleManifest",
  "description": "A compiled course bundle (gameplan §7.5 stage 9): this manifest plus content-addressed files. Byte-for-byte deterministic: the same sources and tool versions always give the same hash.",
  "type": "object",
  "required": ["formatVersion", "id", "course", "target", "orthographies", "support", "versions", "files", "units", "licenses", "provenance"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 0 },
    "id": { "description": "sha256 of the manifest without this field.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "course": { "type": "string" },
    "target": { "$ref": "common.schema.json#/$defs/ScriptedLangTag" },
    "orthographies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/OrthographyId" } },
    "support": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/OrthographyId" } },
    "facets": {
      "description": "The facets the course practises, where it names them (course source `facets`, ADR 0071); absent: all of them.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/Facet" }
    },
    "versions": {
      "description": "Everything that can change the output: schema, Unicode and CLDR data, analyzers, ICU.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "files": {
      "description": "Every file in the bundle by role, with its SPDX license.",
      "type": "array",
      "items": { "$ref": "#/$defs/BundleFile" }
    },
    "units": {
      "description": "The units in path order. Each is a download unit for offline use (gameplan §16 Phase 10): its JSON is part of the course, which every device keeps, and `assets` are the media (audio and images) its items use, downloaded per unit.",
      "type": "array",
      "items": { "$ref": "#/$defs/BundleManifestUnit" }
    },
    "licenses": { "description": "SPDX expression → number of content items.", "type": "object", "additionalProperties": { "type": "integer" } },
    "provenance": { "description": "Counts by status and author kind.", "type": "object", "additionalProperties": { "type": "integer" } },
    "release": { "description": "A release build (ADR 0073): only content a reviewer signed off. Absent in the demo's full builds, which keep drafts.", "type": "boolean" }
  },
  "$defs": {
    "BundleFile": {
      "title": "BundleFile",
      "type": "object",
      "required": ["path", "role", "sha256", "license", "bytes"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "role": { "type": "string", "enum": ["unit", "profile", "table", "keyboard", "image", "audio", "audio-index"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "license": { "type": "string" },
        "source": { "type": "string" },
        "bytes": { "description": "Size in bytes, to say what a download costs before it starts.", "type": "integer", "minimum": 0 }
      }
    },
    "BundleManifestUnit": {
      "title": "BundleManifestUnit",
      "type": "object",
      "required": ["id", "file", "assets"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "file": { "type": "string" },
        "assets": { "description": "Paths of the media files (roles audio and image) the unit's items use, sorted. A file shared by units is listed in each.", "type": "array", "items": { "type": "string" } }
      }
    },
    "BundleUnit": {
      "title": "BundleUnit",
      "type": "object",
      "required": ["id", "kcs", "nodes", "sentences"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "cefr": { "type": "string" },
        "title": { "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } },
        "kcs": { "type": "array", "items": { "$ref": "#/$defs/BundleKc" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/BundleNode" } },
        "sentences": { "type": "array", "items": { "$ref": "#/$defs/BundleSentence" } },
        "stories": { "type": "array", "items": { "$ref": "#/$defs/BundleStory" } },
        "scenarios": { "type": "array", "items": { "$ref": "#/$defs/BundleScenario" } }
      }
    },
    "BundleScenario": {
      "title": "BundleScenario",
      "description": "A roleplay scenario card (Phase 8, §13.4); its texts per support language.",
      "type": "object",
      "required": ["id", "after", "title", "setting", "character", "goal", "license"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "after": { "description": "The path node completed before the scenario opens.", "type": "string" },
        "title": { "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } },
        "setting": { "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } },
        "character": { "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } },
        "goal": { "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } },
        "provenance": { "$ref": "course-source.schema.json#/$defs/Provenance" },
        "license": { "type": "string" }
      }
    },
    "BundleStory": {
      "title": "BundleStory",
      "description": "A compiled story (Phase 6): its lines in every orthography of the course, translations and questions in every support language.",
      "type": "object",
      "required": ["id", "node", "title", "characters", "steps", "kcs", "license"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "node": { "type": "string" },
        "title": { "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "description": "Per orthography.", "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } }
            }
          }
        },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/BundleStoryStep" } },
        "kcs": { "description": "Every KC its lines use.", "type": "array", "items": { "$ref": "common.schema.json#/$defs/KcId" } },
        "provenance": { "$ref": "course-source.schema.json#/$defs/Provenance" },
        "license": { "type": "string" }
      }
    },
    "BundleStoryStep": {
      "title": "BundleStoryStep",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "line": { "$ref": "#/$defs/BundleStoryLine" },
        "choose": {
          "type": "object",
          "required": ["prompt", "options", "answer"],
          "additionalProperties": false,
          "properties": {
            "prompt": { "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } },
            "options": { "type": "array", "items": { "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } } },
            "answer": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "BundleStoryLine": {
      "title": "BundleStoryLine",
      "type": "object",
      "required": ["forms", "translations", "kcs"],
      "additionalProperties": false,
      "properties": {
        "speaker": { "type": "string" },
        "forms": { "description": "Per orthography.", "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } },
        "translations": { "description": "Per support language.", "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } },
        "kcs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/KcId" } },
        "ask": { "type": "string", "enum": ["complete", "arrange"] },
        "gap": { "$ref": "common.schema.json#/$defs/KcId" },
        "distractors": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/KcId" } }
      }
    },
    "BundleKc": {
      "title": "BundleKc",
      "type": "object",
      "required": ["id", "kind", "prerequisites"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/KcId" },
        "kind": { "type": "string", "enum": ["sense", "form", "construction", "grapheme", "reading", "phone", "tone"] },
        "prerequisites": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/KcId" } },
        "cefr": { "type": "string" },
        "gloss": { "type": "object", "additionalProperties": { "$ref": "tagged-text.schema.json" } },
        "forms": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "tagged-text.schema.json" } } },
        "image": { "description": "Bundle path of the KC's picture (a file with role image).", "type": "string" }
      }
    },
    "BundleNode": {
      "title": "BundleNode",
      "type": "object",
      "required": ["id", "kind", "introduces", "reinforces", "sentences"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "introduces": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/KcId" } },
        "reinforces": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/KcId" } },
        "sentences": { "type": "array", "items": { "type": "string" } },
        "convert": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
        }
      }
    },
    "BundleSentence": {
      "title": "BundleSentence",
      "type": "object",
      "required": ["id", "node", "forms", "translations", "kcs", "production", "provenance", "license"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "node": { "type": "string" },
        "forms": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": { "text": { "$ref": "tagged-text.schema.json" }, "reverse": { "type": "string" } }
          }
        },
        "translations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["text", "accept"],
            "additionalProperties": false,
            "properties": { "text": { "$ref": "tagged-text.schema.json" }, "accept": { "type": "string" } }
          }
        },
        "kcs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/KcId" } },
        "production": { "type": "boolean" },
        "register": { "type": "string" },
        "persons": { "$ref": "common.schema.json#/$defs/Persons" },
        "provenance": { "$ref": "course-source.schema.json#/$defs/Provenance" },
        "license": { "type": "string" }
      }
    },
    "BundleAudio": {
      "title": "BundleAudio",
      "description": "audio.json (role audio-index): playable clips by item (sentence or KC id).",
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "object", "additionalProperties": { "$ref": "#/$defs/BundleAudioItem" } }
      }
    },
    "BundleAudioItem": {
      "title": "BundleAudioItem",
      "type": "object",
      "required": ["normal"],
      "additionalProperties": false,
      "properties": {
        "normal": { "$ref": "#/$defs/BundleClip" },
        "slow": { "$ref": "#/$defs/BundleClip" }
      }
    },
    "BundleClip": {
      "title": "BundleClip",
      "type": "object",
      "required": ["path", "durationMs", "synthetic", "license"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 1 },
        "synthetic": { "type": "boolean" },
        "license": { "type": "string" },
        "credit": { "description": "Attribution: the speaker, or the synthetic voice.", "type": "string" },
        "timings": { "type": "array", "items": { "$ref": "audio-index.schema.json#/$defs/TokenTiming" } }
      }
    }
  }
}

{
  "$comment": "Spelling hbo's lexical forms (docs/rules/hbo.md): hbo-Hebr/tiberian's `spell` statements, the orthography's (its letters, as grading keys a typed answer) and its vocalized layer's (the pointed text the course writes), over a form in hbo's notation (lexicons/hbo/language.yaml). One vector or more per rule, each with the course's word as `expected` (the spelling, or one of its free alternatives); a few constructed where the course has none.",
  "vectors": [
    {
      "id": "spell/hbo/consonants/points",
      "op": "spell",
      "args": {
        "profile": "hbo-Hebr/tiberian",
        "form": "אָדָם",
        "expected": "אָדָם"
      },
      "expected": {
        "spelling": "אדם",
        "expected": "spelling"
      },
      "note": "The points go: lexeme:adam."
    },
    {
      "id": "spell/hbo/consonants/final-medial",
      "op": "spell",
      "args": {
        "profile": "hbo-Hebr/tiberian",
        "form": "שֵׁםִ+י",
        "expected": "שְׁמִי"
      },
      "expected": {
        "spelling": "שמי",
        "expected": "spelling"
      },
      "note": "A final letter a suffix follows is medial; the letters only are compared (constructed: shem + -î)."
    },
    {
      "id": "spell/hbo/consonants/medial-final",
      "op": "spell",
      "args": {
        "profile": "hbo-Hebr/tiberian",

      "content": "whitespace",
      "runtime": "grapheme"
     },
     "normalize": [
      "nfc"
     ],
     "match": {
      "case": {
       "locale": "en"
      }
     },
     "layout": {
      "vertical": "none"
     },
     "spell": {
      "from": "lexical",
      "decompose": true,
      "rules": [
       {
        "find": "\u0304",
        "to": ""
       },
       {
        "find": "\u0301",
        "before": "{NV}*$",
        "to": "\u0301",
        "alternatives": [
         {
          "id": "grave",
          "to": "\u0300"
         }
        ]
       }
      ],
      "sets": {
       "NV": "[b-df-hj-np-tv-xz\\u0300-\\u036f]"
      }
     }
    },
    "notation": {
     "sets": {
      "V": "[aeiouy]"
     },
     "order": "[\u0304 \u0301]"
    },
    "form": "theós"
   },
   "expected": {
    "spelling": "theós",
    "alternatives": [
     {
      "spelling": "theòs",
      "by": [
       "grave"
      ]
     }
    ]
   },
   "note": "decompose: the rules read the form as NFD, so the acute NFC composes into ó is a mark a rule finds (a final acute's grave alternative); the spelling is NFC again."
  },
